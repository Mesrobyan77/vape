{
  "name": "vape-hub",
  "version": "0.1.0",
  "private": true,
  "description": "Vape Hub — full-stack Next.js storefront, API (Route Handlers), MongoDB Atlas and Cloudinary.",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "dev:memory": "tsx scripts/dev-memory.ts",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:server": "vitest run --project unit --project integration",
    "test:ui": "vitest run --project ui",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:report": "playwright show-report",
    "seed:dev": "tsx scripts/seed-dev.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "jobs:run": "tsx scripts/run-jobs.ts",
    "media:upload": "tsx scripts/upload-media.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.2",
    "@next/env": "^16.4.2",
    "@tanstack/react-query": "^5.104.5",
    "argon2": "^0.45.1",
    "cloudinary": "^2.11.0",
    "clsx": "^2.1.1",
    "file-type": "^22.2.0",
    "lucide-react": "^1.61.0",
    "mongoose": "^8.24.6",
    "motion": "^14.6.0",
    "next": "^16.4.2",
    "next-intl": "^4.14.9",
    "nodemailer": "^10.2.1",
    "otplib": "^13.5.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.2",
    "jsdom": "^26.1.0",
    "mongodb-memory-server": "^10.4.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
