# Vape Hub — single Next.js app. Copy to .env.local and fill in. Placeholders only; never commit real values.
NODE_ENV=development

# Public origin of this site (canonical URLs, sitemap, CSRF/Origin allow-list). https:// required in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional extra allowed origins for state-changing requests (comma separated).
ALLOWED_ORIGINS=

# MongoDB Atlas (or any replica set — transactions are required).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=vapehub

# Security (required in production). SESSION_SECRET ≥ 32 random chars; MFA key = `openssl rand -base64 32`.
SESSION_SECRET=replace-with-at-least-32-random-characters
MFA_ENCRYPTION_KEY=replace-with-32-bytes-base64
COOKIE_DOMAIN=

# Cloudinary (admin uploads). Leave empty to disable uploads (API answers 503 UPLOADS_NOT_CONFIGURED).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP (emails). Without SMTP, non-production environments capture emails in the database.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Vape Hub <no-reply@example.am>"
ADMIN_NOTIFY_EMAIL=

# Pexels (optional, admin image discovery; server-side only).
PEXELS_API_KEY=

# Payments: live | mock | disabled. mock is refused in production. COD always works.
PAYMENT_MODE=disabled
MOCK_PAYMENT_SECRET=
IDRAM_REC_ACCOUNT=
IDRAM_SECRET_KEY=
IDRAM_FORM_URL=
ARCA_API_URL=
ARCA_USERNAME=
ARCA_PASSWORD=

# Background jobs: in-process loop (default true) and/or POST /api/v1/cron/run with Bearer CRON_SECRET.
JOBS_IN_PROCESS=true
CRON_SECRET=

# Rate limits: memory (single instance) | mongo (default in production, shared across instances).
RATE_LIMIT_STORE=
TRUST_PROXY_HEADERS=true

LOG_LEVEL=info

# E2E only (never in production): enables /api/v1/test-support/* with X-Test-Token.
E2E_TEST_API_TOKEN=
